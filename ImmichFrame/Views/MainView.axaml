<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ImmichFrame.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="800"
             x:Class="ImmichFrame.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="Opacity" Value="0.88" />
      <Setter Property="Foreground" Value="{Binding Settings.FontColor}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.gestureZone">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.overlayAction">
      <Setter Property="Width" Value="76" />
      <Setter Property="Height" Value="68" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.overlayAction:pointerover">
      <Setter Property="Background" Value="#30FFFFFF" />
    </Style>
    <Style Selector="TextBlock.actionLabel">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.pauseLabel">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*">
    <TransitioningContentControl x:Name="transitioningControl"
                                 Grid.ColumnSpan="3"
                                 Grid.RowSpan="3"
                                 Content="{Binding Images}">
      <TransitioningContentControl.PageTransition>
        <CrossFade Duration="0:00:01.000" />
      </TransitioningContentControl.PageTransition>
      <TransitioningContentControl.ContentTemplate>
        <DataTemplate>
          <Grid Background="#111315">
            <Border IsVisible="{Binding ShowDarkGradient}">
              <Border.Background>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="0.7" RadiusY="0.7">
                  <GradientStop Offset="0" Color="#353A3F" />
                  <GradientStop Offset="0.38" Color="#24282C" />
                  <GradientStop Offset="0.78" Color="#101214" />
                  <GradientStop Offset="1" Color="#08090A" />
                </RadialGradientBrush>
              </Border.Background>
            </Border>

            <Grid IsVisible="{Binding ShowStretchedThumbhash}">
              <Image Stretch="Fill"
                     Source="{Binding ThumbhashImage}"
                     RenderOptions.BitmapInterpolationMode="MediumQuality" />
              <Border Background="#7006080A" />
            </Grid>

            <Grid IsVisible="{Binding ShowBlurredDuplicate}" ClipToBounds="True">
              <Image Stretch="UniformToFill"
                     Source="{Binding Image}"
                     RenderOptions.BitmapInterpolationMode="MediumQuality">
                <Image.Effect>
                  <BlurEffect Radius="22" />
                </Image.Effect>
                <Image.RenderTransform>
                  <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                </Image.RenderTransform>
              </Image>
              <Border Background="#7006080A" />
            </Grid>

            <Image Stretch="{Binding ImageStretch}" Source="{Binding Image}">
              <Image.RenderTransform>
                <ScaleTransform ScaleX="{Binding DataContext.ImageScale, RelativeSource={RelativeSource AncestorType={x:Type TransitioningContentControl}}}"
                                ScaleY="{Binding DataContext.ImageScale, RelativeSource={RelativeSource AncestorType={x:Type TransitioningContentControl}}}" />
              </Image.RenderTransform>
            </Image>
          </Grid>
        </DataTemplate>
      </TransitioningContentControl.ContentTemplate>
    </TransitioningContentControl>

    <!-- Static scrims keep information readable on pale photos without using
         blur or another animated effect on the low-power GPU. -->
    <Border Grid.ColumnSpan="3"
            Grid.Row="2"
            IsHitTestVisible="False"
            ZIndex="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Offset="0" Color="#00000000" />
          <GradientStop Offset="0.55" Color="#52000000" />
          <GradientStop Offset="1" Color="#B8000000" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Button Grid.Column="0"
            Grid.Row="1"
            Classes="gestureZone"
            Command="{Binding PreviousImageCommand}"
            HotKey="Left"
            AutomationProperties.Name="Previous photo" />
    <Button Grid.Column="2"
            Grid.Row="1"
            Classes="gestureZone"
            Command="{Binding NextImageCommand}"
            HotKey="Right"
            AutomationProperties.Name="Next photo" />
    <Button Grid.Column="1"
            Grid.Row="1"
            Classes="gestureZone"
            Command="{Binding PauseImageCommand}"
            HotKey="Space"
            AutomationProperties.Name="Pause or resume slideshow" />

    <Border Grid.Column="1"
            Grid.Row="1"
            IsVisible="{Binding ImagePaused}"
            IsHitTestVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="18,10"
            Background="#B8000000"
            CornerRadius="18"
            ZIndex="2">
      <TextBlock Classes="pauseLabel" Text="Paused" />
    </Border>

    <Border Grid.Column="2"
            Grid.Row="0"
            IsVisible="{Binding ImagePaused}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="16"
            Padding="5"
            Background="#CC171717"
            CornerRadius="18"
            ZIndex="3">
      <StackPanel Orientation="Horizontal">
        <Button Classes="overlayAction"
                Command="{Binding NavigateSettingsPageCommand}"
                HotKey="Up"
                ToolTip.Tip="Open settings"
                AutomationProperties.Name="Open settings">
          <StackPanel Spacing="2">
            <PathIcon Width="26"
                      Height="26"
                      Foreground="White"
                      HorizontalAlignment="Center"
                      Data="M19.43,12.98c0.04,-0.32 0.07,-0.65 0.07,-0.98s-0.02,-0.66 -0.07,-0.98l2.11,-1.65c0.19,-0.15 0.24,-0.42 0.12,-0.64l-2,-3.46c-0.12,-0.22 -0.37,-0.31 -0.6,-0.22l-2.49,1c-0.52,-0.4 -1.08,-0.73 -1.69,-0.98L14.5,1.42C14.47,1.18 14.25,1 14,1h-4c-0.25,0 -0.46,0.18 -0.5,0.42L9.12,4.07c-0.61,0.25 -1.17,0.59 -1.69,0.98l-2.49,-1c-0.23,-0.08 -0.48,0 -0.6,0.22l-2,3.46c-0.13,0.22 -0.07,0.49 0.12,0.64l2.11,1.65C4.53,10.34 4.5,10.68 4.5,11s0.02,0.66 0.07,0.98l-2.11,1.65c-0.19,0.15 -0.24,0.42 -0.12,0.64l2,3.46c0.12,0.22 0.37,0.31 0.6,0.22l2.49,-1c0.52,0.4 1.08,0.73 1.69,0.98l0.38,2.65c0.04,0.24 0.25,0.42 0.5,0.42h4c0.25,0 0.46,-0.18 0.5,-0.42l0.38,-2.65c0.61,-0.25 1.17,-0.58 1.69,-0.98l2.49,1c0.23,0.08 0.48,0 0.6,-0.22l2,-3.46c0.12,-0.22 0.07,-0.49 -0.12,-0.64zM12,15.5A4.5,4.5 0 1 1 12,6a4.5,4.5 0 0 1 0,9.5z" />
            <TextBlock Classes="actionLabel" Text="Settings" />
          </StackPanel>
        </Button>
        <Button Classes="overlayAction"
                Command="{Binding QuitCommand}"
                HotKey="Down"
                ToolTip.Tip="Exit app"
                AutomationProperties.Name="Exit app">
          <StackPanel Spacing="2">
            <PathIcon Width="26"
                      Height="26"
                      Foreground="White"
                      HorizontalAlignment="Center"
                      Data="M10.09,15.59L11.5,17l5,-5 -5,-5 -1.41,1.41L12.67,11H3v2h9.67zM19,3H5c-1.11,0 -2,0.9 -2,2v4h2V5h14v14H5v-4H3v4c0,1.1 0.89,2 2,2h14c1.1,0 2,-0.9 2,-2V5c0,-1.1 -0.9,-2 -2,-2z" />
            <TextBlock Classes="actionLabel" Text="Exit" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <StackPanel Grid.Column="0" Grid.Row="2" Margin="10" VerticalAlignment="Bottom" ZIndex="2">
      <StackPanel Orientation="Horizontal">
        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   IsVisible="{Binding Settings.ShowWeather}"
                   Text="{Binding WeatherTemperature}"
                   FontSize="{Binding Settings.WeatherFontSize}" />
        <Image Source="{Binding WeatherImage}" VerticalAlignment="Center" MaxWidth="30" Margin="5,0" />
      </StackPanel>
      <TextBlock HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 IsVisible="{Binding Settings.ShowWeatherDescription}"
                 Text="{Binding WeatherCurrent}"
                 FontSize="{Binding Settings.WeatherFontSize}" />
      <TextBlock HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 IsVisible="{Binding Settings.ShowClock}"
                 Text="{Binding LiveTime}"
                 FontSize="{Binding Settings.ClockFontSize}"
                 FontWeight="Bold" />
    </StackPanel>

    <TextBlock Grid.Column="2"
               Grid.Row="2"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="10"
               IsVisible="{Binding Settings.ShowPhotoDate}"
               Text="{Binding ImageDate}"
               FontSize="{Binding Settings.PhotoDateFontSize}"
               ZIndex="2" />
    <TextBlock Grid.Column="1"
               Grid.Row="2"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               Margin="10"
               IsVisible="{Binding Settings.ShowImageDesc}"
               Text="{Binding ImageDesc}"
               FontSize="{Binding Settings.ImageDescFontSize}"
               ZIndex="2" />
    <TextBlock Grid.Column="0"
               Grid.Row="0"
               Margin="20"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               IsVisible="{Binding IsImageLocationVisible}"
               Text="{Binding ImageLocation}"
               FontSize="{Binding Settings.ImageLocationFontSize}"
               ZIndex="2" />
  </Grid>
</UserControl>
