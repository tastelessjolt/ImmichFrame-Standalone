<UserControl x:Class="ImmichFrame.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ImmichFrame.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="800"
             x:DataType="vm:SettingsViewModel">
  <Design.DataContext>
    <vm:SettingsViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <DataTemplate x:Key="PersonListItemTemplate" x:DataType="vm:PersonListItem">
      <Grid ColumnDefinitions="Auto,*"
            MinHeight="52"
            AttachedToVisualTree="PersonRow_AttachedToVisualTree"
            DetachedFromVisualTree="PersonRow_DetachedFromVisualTree"
            AutomationProperties.Name="{Binding DisplayName}">
        <Border Width="48"
                Height="48"
                Margin="0,0,10,0"
                Background="#183B82F6"
                BorderBrush="#383B82F6"
                BorderThickness="1"
                CornerRadius="24"
                ClipToBounds="True">
          <Grid>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#DDE8FF"
                       IsVisible="{Binding IsThumbnailPlaceholderVisible}"
                       Text="{Binding Initials}" />
            <Image Source="{Binding Thumbnail}"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapInterpolationMode="MediumQuality" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
          <TextBlock FontSize="17"
                     FontWeight="Medium"
                     Text="{Binding DisplayName}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="supporting"
                     FontSize="13"
                     IsVisible="{Binding HasDetail}"
                     Text="{Binding Detail}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="UnnamedPersonGridRowTemplate" x:DataType="vm:PersonGridRow">
      <ItemsControl ItemsSource="{Binding People}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="10" Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PersonListItem">
            <ToggleButton Classes="faceCell"
                          Margin="3"
                          Padding="5"
                          MinWidth="96"
                          MinHeight="112"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.SelectUnnamedPersonCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding SelectionLabel}">
              <StackPanel HorizontalAlignment="Center" Spacing="3">
                <Border Width="80"
                        Height="80"
                        HorizontalAlignment="Center"
                        Background="#183B82F6"
                        BorderBrush="#483B82F6"
                        BorderThickness="1"
                        CornerRadius="40"
                        ClipToBounds="True">
                  <Grid AttachedToVisualTree="PersonRow_AttachedToVisualTree"
                        DetachedFromVisualTree="PersonRow_DetachedFromVisualTree">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#DDE8FF"
                               IsVisible="{Binding IsThumbnailPlaceholderVisible}"
                               Text="?" />
                    <Image Source="{Binding Thumbnail}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapInterpolationMode="MediumQuality" />
                  </Grid>
                </Border>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="12"
                           Opacity="0.78"
                           Text="{Binding SelectionLabel}" />
              </StackPanel>
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,5" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
    <Style Selector="TextBlock.supporting">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Opacity" Value="0.72" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="FormatString" Value="F0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Margin" Value="0,2,0,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Fluent pins the 32px checkbox glyph row to the top. Center it inside
         our larger 52px touch target so the glyph and Google Sans label align. -->
    <Style Selector="CheckBox /template/ Grid">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="HyperlinkButton">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBox.empty:empty">
      <Setter Property="BorderBrush" Value="Red" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#PART_Header">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="FontFamily" Value="{StaticResource GoogleSans}" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.faceCell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ToggleButton.faceCell:checked">
      <Setter Property="Background" Value="#263B82F6" />
      <Setter Property="BorderBrush" Value="#A83B82F6" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="scrollViewer">
    <StackPanel Margin="20,14,20,24" Spacing="2">
      <Expander x:Name="serverExpander" Header="Server" Expanded="Expander_Expanded">
        <StackPanel Margin="12,4,12,16">
          <TextBlock Classes="fieldLabel" Text="Immich server URL" />
          <TextBox x:Name="txtImmichServerUrl"
                   Text="{Binding Settings.ImmichServerUrl}"
                   Watermark="http://192.168.0.100:2283"
                   Classes="empty" />
          <HyperlinkButton Content="How to obtain an API key"
                           NavigateUri="https://immich.app/docs/features/command-line-interface#obtain-the-api-key" />
          <TextBox Text="{Binding Settings.ApiKey}"
                   Watermark="Immich API key"
                   Classes="empty" />
        </StackPanel>
      </Expander>

      <Expander Header="Image options" Expanded="Expander_Expanded">
        <Grid Margin="12,4,12,16" ColumnDefinitions="*,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="fieldLabel" Text="Image fill" />
            <ComboBox SelectedItem="{Binding Settings.ImageStretch}" ItemsSource="{Binding StretchOptions}" />
            <TextBlock Classes="fieldLabel" Text="Letterbox background" />
            <ComboBox SelectedItem="{Binding Settings.LetterboxBackground}"
                      ItemsSource="{Binding LetterboxBackgroundChoices}" />
            <TextBlock Classes="supporting" Text="Used when Image fill leaves space around a photo." />
            <TextBlock Classes="fieldLabel" Text="Interval (seconds)" />
            <NumericUpDown Value="{Binding Settings.Interval}" Minimum="2" KeyDown="NumericUpDown_KeyDown" />
            <TextBlock Classes="fieldLabel" Text="Transition animation" />
            <ComboBox SelectedItem="{Binding Settings.TransitionAnimation}"
                      ItemsSource="{Binding TransitionAnimationChoices}" />
            <TextBlock Classes="supporting" Text="Previous reverses directional transitions." />
            <TextBlock Classes="fieldLabel" Text="Transition duration (seconds)" />
            <NumericUpDown Value="{Binding Settings.TransitionDuration}"
                           Minimum="0"
                           Maximum="5"
                           Increment="0.1"
                           FormatString="0.0"
                           KeyDown="NumericUpDown_KeyDown" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <CheckBox Content="Download images for offline reuse" IsChecked="{Binding Settings.DownloadImages}" />
            <CheckBox Content="Slow pan and zoom" IsChecked="{Binding Settings.ImageZoom}" />
            <TextBlock Classes="fieldLabel" Text="Renew downloaded images after (days)" />
            <NumericUpDown Value="{Binding Settings.RenewImagesDuration}" Minimum="1" KeyDown="NumericUpDown_KeyDown" />
          </StackPanel>
        </Grid>
      </Expander>

      <Expander Header="Albums, people and memories" Expanded="Expander_Expanded">
        <StackPanel Margin="12,4,12,16" Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="sectionTitle" Text="Included album IDs" />
            <Button Grid.Column="1" Content="Add album ID" Command="{Binding AddAlbumCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding AlbumList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding Value}" Watermark="Album UUID" />
                  <Button Grid.Column="1"
                          Content="Remove"
                          Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.RemoveAlbumCommand}"
                          CommandParameter="{Binding Id}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="sectionTitle" Text="Excluded album IDs" />
            <Button Grid.Column="1" Content="Add album ID" Command="{Binding AddExcludedAlbumCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding ExcludedAlbumList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding Value}" Watermark="Album UUID" />
                  <Button Grid.Column="1"
                          Content="Remove"
                          Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.RemoveExcludedAlbumCommand}"
                          CommandParameter="{Binding Id}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator Margin="0,10" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="sectionTitle" Text="People" />
              <TextBlock Classes="supporting" Text="{Binding PeopleStatus}" />
              <TextBlock Classes="supporting"
                         Text="Immich ranks each group by photo frequency. Face thumbnails load only while visible." />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh people" Command="{Binding RefreshPeopleCommand}" />
          </Grid>

          <TextBlock Classes="sectionTitle" Text="Named people" />
          <Grid ColumnDefinitions="1.35*,*,*">
            <Border Grid.Column="0" BorderBrush="#557A7A7A" BorderThickness="1" CornerRadius="12" Padding="10">
              <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Classes="sectionTitle" Text="Available" />
                <ListBox Grid.Row="1"
                         Height="220"
                         ItemsSource="{Binding AvailablePeople}"
                         ItemTemplate="{StaticResource PersonListItemTemplate}"
                         SelectedItem="{Binding SelectedAvailablePerson}" />
                <UniformGrid Grid.Row="2" Columns="2" Margin="0,6,0,0">
                  <Button Content="Include" Command="{Binding IncludePersonCommand}" />
                  <Button Content="Exclude" Command="{Binding ExcludePersonCommand}" />
                </UniformGrid>
              </Grid>
            </Border>

            <Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="#557A7A7A" BorderThickness="1" CornerRadius="12" Padding="10">
              <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Classes="sectionTitle" Text="Included" />
                <ListBox Grid.Row="1"
                         Height="220"
                         ItemsSource="{Binding IncludedPeople}"
                         ItemTemplate="{StaticResource PersonListItemTemplate}"
                         SelectedItem="{Binding SelectedIncludedPerson}" />
                <Button Grid.Row="2" Content="Remove selected" Command="{Binding RemoveIncludedPersonCommand}" />
              </Grid>
            </Border>

            <Border Grid.Column="2" Margin="8,0,0,0" BorderBrush="#557A7A7A" BorderThickness="1" CornerRadius="12" Padding="10">
              <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Classes="sectionTitle" Text="Excluded" />
                <ListBox Grid.Row="1"
                         Height="220"
                         ItemsSource="{Binding ExcludedPeople}"
                         ItemTemplate="{StaticResource PersonListItemTemplate}"
                         SelectedItem="{Binding SelectedExcludedPerson}" />
                <Button Grid.Row="2" Content="Remove selected" Command="{Binding RemoveExcludedPersonCommand}" />
              </Grid>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Classes="sectionTitle" Text="Unnamed faces" />
              <TextBlock Classes="supporting"
                         Text="Larger thumbnails use the full width; highest-photo-count faces appear first." />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Classes="supporting"
                       Margin="12,0,0,0"
                       Text="{Binding UnnamedSelectionStatus}" />
          </Grid>
          <Border BorderBrush="#557A7A7A"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="8">
            <Grid RowDefinitions="*,Auto">
              <ListBox Classes="unnamedGrid"
                       Height="350"
                       ItemsSource="{Binding UnnamedPeopleRows}"
                       ItemTemplate="{StaticResource UnnamedPersonGridRowTemplate}"
                       SelectionMode="Single"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="MinHeight" Value="118" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  </Style>
                </ListBox.Styles>
              </ListBox>
              <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,0">
                <Button Content="Set available" Command="{Binding MakeUnnamedAvailableCommand}" />
                <Button Content="Include selected" Command="{Binding IncludeUnnamedPersonCommand}" />
                <Button Content="Exclude selected" Command="{Binding ExcludeUnnamedPersonCommand}" />
              </UniformGrid>
            </Grid>
          </Border>

          <TextBlock Classes="fieldLabel" Text="Refresh album and people results every (hours)" />
          <NumericUpDown Value="{Binding Settings.RefreshAlbumPeopleInterval}" Minimum="1" KeyDown="NumericUpDown_KeyDown" />
          <CheckBox Content="Show anniversary memories" IsChecked="{Binding Settings.ShowMemories}" />
        </StackPanel>
      </Expander>

      <Expander Header="Clock" Expanded="Expander_Expanded">
        <Grid Margin="12,4,12,16" ColumnDefinitions="*,*">
          <StackPanel Grid.Column="0">
            <CheckBox Content="Show clock" IsChecked="{Binding Settings.ShowClock}" />
            <TextBlock Classes="fieldLabel" Text="Clock size" />
            <NumericUpDown Value="{Binding Settings.ClockFontSize}" Minimum="12" KeyDown="NumericUpDown_KeyDown" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Classes="fieldLabel" Text="Clock format" />
            <TextBox Text="{Binding Settings.ClockFormat}" />
            <TextBlock Classes="supporting" Text="The clock is displayed in bold for better readability." />
          </StackPanel>
        </Grid>
      </Expander>

      <Expander Header="Photo information" Expanded="Expander_Expanded">
        <Grid Margin="12,4,12,16" ColumnDefinitions="*,*">
          <StackPanel Grid.Column="0">
            <CheckBox Content="Show photo date" IsChecked="{Binding Settings.ShowPhotoDate}" />
            <TextBlock Classes="fieldLabel" Text="Photo date size" />
            <NumericUpDown Value="{Binding Settings.PhotoDateFontSize}" Minimum="12" KeyDown="NumericUpDown_KeyDown" />
            <TextBlock Classes="fieldLabel" Text="Photo date format" />
            <TextBox Text="{Binding Settings.PhotoDateFormat}" />
            <CheckBox Content="Show description" IsChecked="{Binding Settings.ShowImageDesc}" />
            <TextBlock Classes="fieldLabel" Text="Description size" />
            <NumericUpDown Value="{Binding Settings.ImageDescFontSize}" Minimum="12" KeyDown="NumericUpDown_KeyDown" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <CheckBox Content="Show location" IsChecked="{Binding Settings.ShowImageLocation}" />
            <TextBlock Classes="fieldLabel" Text="Location format" />
            <ComboBox SelectedItem="{Binding Settings.ImageLocationFormat}" ItemsSource="{Binding ImageLocationOptions}" />
            <TextBlock Classes="fieldLabel" Text="Location size" />
            <NumericUpDown Value="{Binding Settings.ImageLocationFontSize}" Minimum="12" KeyDown="NumericUpDown_KeyDown" />
          </StackPanel>
        </Grid>
      </Expander>

      <Expander Header="Weather" Expanded="Expander_Expanded">
        <Grid Margin="12,4,12,16" ColumnDefinitions="*,*">
          <StackPanel Grid.Column="0">
            <HyperlinkButton Content="How to obtain an OpenWeather API key" NavigateUri="https://openweathermap.org/appid" />
            <TextBox Text="{Binding Settings.WeatherApiKey}" Watermark="OpenWeather API key" />
            <CheckBox Content="Show weather description" IsChecked="{Binding Settings.ShowWeatherDescription}" />
            <TextBlock Classes="fieldLabel" Text="Weather text size" />
            <NumericUpDown Value="{Binding Settings.WeatherFontSize}" Minimum="12" KeyDown="NumericUpDown_KeyDown" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Classes="fieldLabel" Text="Unit system" />
            <TextBox Text="{Binding Settings.UnitSystem}" Watermark="metric or imperial" />
            <TextBlock Classes="fieldLabel" Text="Latitude, longitude" />
            <TextBox Text="{Binding Settings.WeatherLatLong}" />
            <CheckBox Content="Sleep at midnight and wake at sunrise"
                      IsChecked="{Binding Settings.SunriseScreenScheduleEnabled}" />
            <TextBlock Classes="supporting"
                       Text="Uses these coordinates and the device time zone. Sunrise is calculated locally without another weather request." />
            <TextBlock Classes="fieldLabel" Text="Language" />
            <TextBox Text="{Binding Settings.Language}" />
          </StackPanel>
        </Grid>
      </Expander>

      <Expander Header="Other" Expanded="Expander_Expanded">
        <Grid Margin="12,4,12,16" ColumnDefinitions="*,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="fieldLabel" Text="Screen margin" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding Settings.Margin}" />
              <Button Grid.Column="1" Content="Apply" Command="{Binding TestMarginCommand}" />
            </Grid>
            <TextBlock Classes="fieldLabel" Text="Recent-photos album name" />
            <TextBox Text="{Binding Settings.ImmichFrameAlbumName}" Watermark="Leave blank to disable" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Classes="fieldLabel" Text="Interface text color" />
            <TextBox Text="{Binding Settings.FontColor}" />
            <CheckBox Content="Unattended mode (hide recoverable errors)" IsChecked="{Binding Settings.UnattendedMode}" />
          </StackPanel>
        </Grid>
      </Expander>

      <UniformGrid Columns="5" Margin="0,12,0,0">
        <Button Content="Cancel" IsVisible="{Binding CancelVisible}" Command="{Binding CancelCommand}" />
        <Button Content="Save" Command="{Binding SaveCommand}" Click="OnSaveClick" />
        <Button Content="Exit app" Command="{Binding QuitCommand}" />
        <Button Content="Backup" Command="{Binding BackupCommand}" />
        <Button Content="Restore" Command="{Binding RestoreCommand}" />
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
